# Jupiter API key (developers.jup.ag/portal) — sent as x-api-key header
JUP_API=jup_your_key_here
# CSV output directory (docker default /app/data; local dev: ./data)
CSV_DIR=./data
# Base poll interval in ms (±250ms jitter applied)
POLL_INTERVAL_MS=5000
# Quote size for SOL->USDC in lamports (0.1 SOL)
QUOTE_SOL_LAMPORTS=100000000
# Health endpoint port
PORT=8080
# debug|info|warn|error
LOG_LEVEL=info
